<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vikim.demo.tag.DirectoryNodeTagMapper">

    <insert id="batchCreateDirectoryNodeTags">
        insert into directory_node_tags (directory_node_id, tag_id)
        values
        <foreach collection="tagIds" item="tagId" separator=",">
            (#{directoryNodeId}, #{tagId})
        </foreach>
    </insert>

    <delete id="batchDeleteDirectoryNodeTags">
        delete from directory_node_tags
        where directory_node_id = #{id}
    </delete>

    <select id="getTagsByDirectoryNodeId" resultType="com.vikim.demo.tag.TagRow">
        select t.id, t.name, t.created_at
        from directory_node_tags dnt
        join tags t on t.id = dnt.tag_id
        where dnt.directory_node_id = #{directoryNodeId}
    </select>

</mapper>

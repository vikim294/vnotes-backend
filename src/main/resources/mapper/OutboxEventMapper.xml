<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vikim.vnotes.outbox.OutboxEventMapper">

    <update id="pickJobs">
        update outbox_events
        set status = 'SENDING',
            claimed_at = current_timestamp(6),
            claim_version = claim_version + 1
        where event_id in
            <foreach collection="eventIds"
                     item="eventId"
                     open="("
                     separator=","
                     close=")">
                #{eventId}
            </foreach>
    </update>

</mapper>
